# Reg.ru (Apache): всё, что не файл, — во фронт-контроллер
Options -Indexes
ServerSignature Off
RewriteEngine On
# служебные файлы (.htaccess, .user.ini, .git…) не отдаются
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|bak|log|ini|sql)$">
  Require all denied
</FilesMatch>
# заголовки безопасности для статики (страницы и API получают их из index.php)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset X-Powered-By
</IfModule>
